<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>RORORO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 626 Labs LLC. All rights reserved.</string>

	<!-- ============================================================
	     `roblox-player://` URL scheme registration (Phase 3).
	     When multi-instance is ON, RORORO claims this scheme via
	     `URLSchemeHandler.claim()` so that clicking Play on roblox.com
	     routes the launcher URL through MultiInstanceCoordinator first.
	     The CFBundleURLTypes entry below makes us eligible to be
	     selected as the default handler.

	     CFBundleDocumentTypes is intentionally NEVER added — macRo's
	     Info.plist comments record the regression (registering doc types
	     broke window event routing). Sparkle keys (SUFeedURL / SUPublicEDKey
	     / SUEnable*) land at Phase 6.
	     ============================================================ -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.626labs.rororo-mac.roblox-player</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>roblox-player</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
		</dict>
	</array>

	<!-- ============================================================
	     Sparkle 2.x auto-update configuration (Phase 6).
	     SUPublicEDKey is a placeholder until Estevan generates the EdDSA
	     keypair via Sparkle's generate_keys utility (bootstrap step — see
	     tools/release/README.md). Auto-checks are GATED OFF until bootstrap
	     because firing the updater against an unresolvable public key + a
	     404 appcast surfaces an error dialog whose dismiss path can crash
	     the app. Flip SUEnableAutomaticChecks back to true in the same
	     commit that pastes in the real public key. SUFeedURL is HTTPS-only
	     by hard contract.
	     ============================================================ -->
	<key>SUFeedURL</key>
	<string>https://626labs.github.io/rororo-mac/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>REPLACE_WITH_GENERATED_PUBLIC_KEY</string>
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<key>SUEnableAutomaticChecks</key>
	<false/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
